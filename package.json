{
  "name": "gullbert",
  "version": "0.3.0-beta.3",
  "private": true,
  "description": "A tiny seagull with absolutely no respect for your desktop.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "preview": "node scripts/preview.mjs",
    "test": "npm run build:web && node --test tests/*.test.mjs",
    "test:routing": "node scripts/test-routing.mjs",
    "check": "tsc --noEmit",
    "format": "prettier --write src tests scripts .github package.json README.md CONTRIBUTING.md tsconfig.json src-tauri/tauri.conf.json src-tauri/capabilities && npm run lint:fix",
    "format:check": "prettier --check src tests scripts .github package.json README.md CONTRIBUTING.md tsconfig.json src-tauri/tauri.conf.json src-tauri/capabilities",
    "build:web": "node scripts/build.mjs",
    "watch:web": "node scripts/build.mjs --watch",
    "prepare:vision": "node scripts/prepare-vision.mjs",
    "predev": "node scripts/prepare-vision.mjs --if-windows",
    "prebuild": "node scripts/prepare-vision.mjs --if-windows",
    "lint": "eslint src scripts tests eslint.config.mjs --max-warnings 0",
    "lint:fix": "npm run lint -- --fix"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.7",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tauri-apps/cli": "^2.12.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
